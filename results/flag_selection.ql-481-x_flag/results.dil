overlayLocal
`Overlay::locallyReachableTrapOrTag/3#11241854`(
  boolean isOverlayVariant, interned string sourceFile,
  /* @trap_or_tag */ entity t
)
{
  exists(/* @trap */ interned entity trap |
    exists(/* @source_file */ interned entity sf |
      source_file_name(sf, sourceFile) and source_file_uses_trap(sf, trap)
    ) and
    (t = trap or trap_uses_tag(trap, t))
  ) and
