idDiscard(/* @element */ interned unique entity e) {
  (
    exists(/* @trap_or_tag */ interned dontcare entity _ |
      `#Overlay::locallyInTrapOrTag/3#1694c9f7MergeNoDiscard`(false, e, _)
    ) and
    not(
      exists(/* @trap_or_tag */ interned entity t |
        `#Overlay::locallyInTrapOrTag/3#1694c9f7MergeNoDiscard`(true, e, t) and
        exists(interned dontcare string _ |
          `#Overlay::locallyReachableTrapOrTag/3#11241854MergeNoDiscard`(true,
            _, t)
        )
      )
    ) and
    not(
      exists(interned string sourceFile, /* @trap_or_tag */ interned entity t |
        `#Overlay::locallyInTrapOrTag/3#1694c9f7MergeNoDiscard`(false, e, t) and
        `#Overlay::locallyReachableTrapOrTag/3#11241854MergeNoDiscard`(false,
          sourceFile, t) and
        not(
          #overlayChangedFilesMergeNoDiscard(sourceFile) or
          exists(interned dontcare string _ |
            `#Overlay::locallyReachableTrapOrTag/3#11241854MergeNoDiscard`(true,
              _, t)
          ) or
          exists(/* @trap_or_tag */ dontcare entity _ |
            `#Overlay::locallyReachableTrapOrTag/3#11241854MergeNoDiscard`(true,
              sourceFile, _)
          )
        )
      )
    )
  )
  or
  exists(interned string file |
    (
      #overlayChangedFilesMergeNoDiscard(file) or
      `#OverlayXml::overlayXmlExtracted/1#55443f98MergeNoDiscard`(file)
    ) and
    `#OverlayXml::getXmlFileInBase/1#52500c49MergeNoDiscard`(e, file)
  )
}

#@ppd_defineMergeTypeCall(/* @ppd_define */ interned unique entity X) =
  mergeWithOverlay<faithful discard @ppd_define>(@ppd_define/1, idDiscard/1)
.


#preproctextMerge(
  /* @preprocdirect */ interned entity id, interned string head,
  interned string body
) =
  mergeWithOverlay<discard @preprocdirect,string,string>(preproctext/3,
                                                         idDiscard/1)
.


suppressTypeErrors
`Macro::Macro.getName/0#dispred#e28b3699`(
  /* Macro::Macro */ interned entity this, string result
)
{
  exists(interned string call_result#2 |
    #@ppd_defineMergeTypeCall(this) and
    exists(interned dontcare string _ |
      #preproctextMerge(this, call_result#2, _)
    ) and
    regexpCapture(call_result#2, "([^(]*+).*", 1, result)
  )
}

suppressTypeErrors #select#query(string option, string accessName, string #col) {
  exists(interned string accessStructFieldName |
    exists(string call_result#4 |
      exists(string call_result#5 |
        exists(/* Macro::Macro */ interned entity m |
          exists(string call_result |
            `Macro::Macro.getName/0#dispred#e28b3699`(m, call_result) and
            matches(call_result, "flag_%")
          ) and
          `Macro::Macro.getName/0#dispred#e28b3699`(m, accessName) and
          exists(interned dontcare string _ |
            #preproctextMerge(m, _, accessStructFieldName)
          )
        ) and
        suffix(accessName, 5, call_result#5) and
        replaceAll(call_result#5, "_", "-", call_result#4)
      ) and
      Append("-f", call_result#4, option)
    ) and
    suffix(accessStructFieldName, 15, #col)
  )
}

query #select = #select#query/3 .


